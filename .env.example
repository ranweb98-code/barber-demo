# Copy to `.env.local` for local dev (or run `vercel env pull .env.local` after linking).

# PostgreSQL (Neon via Vercel Storage, or any Postgres URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Admin panel (default in README: barber2024)
ADMIN_PASSWORD=barber2024

# Session signing — long random string
AUTH_SECRET=

# Cron auth (optional locally)
CRON_SECRET=

# Public site URL (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Email (leave RESEND_API_KEY empty to log previews in the console)
RESEND_API_KEY=
EMAIL_FROM=Aviel Naim <onboarding@resend.dev>
OWNER_EMAIL=owner@example.com

# Reminders
REMINDER_HOURS_BEFORE=24
ENABLE_CRON=false

# Web Push (required for production build on Vercel)
# Generate: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
